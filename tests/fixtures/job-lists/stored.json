   }
  ],
  "dependencies": [
   {
    "job_name": "True",
    "depends_on": "20241105",
    "notes": "7"
   },
   {
    "job_name": "2024-11-05",
    "depends_on": "1.5",
    "dependency_type": "service"
   }
  ]
 },
