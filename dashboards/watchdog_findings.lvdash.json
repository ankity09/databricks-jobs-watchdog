{
  "datasets": [
    {
      "name": "ds_now",
      "displayName": "Latest findings",
      "queryLines": [
        "SELECT\n",
        "  environment, job_name, check_id, status, owner,\n",
        "  CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END AS is_failed,\n",
        "  CASE WHEN status = 'WARNING' THEN 1 ELSE 0 END AS is_warning,\n",
        "  CASE WHEN status = 'UNKNOWN' THEN 1 ELSE 0 END AS is_unknown,\n",
        "  CASE WHEN status = 'HEALTHY' THEN 1 ELSE 0 END AS is_healthy,\n",
        "  CASE WHEN status <> 'HEALTHY' THEN 1 ELSE 0 END AS is_problem,\n",
        "  element_at(array('HEALTHY', 'WARNING', 'UNKNOWN', 'FAILED'),\n",
        "    MAX(CASE status WHEN 'HEALTHY' THEN 1 WHEN 'WARNING' THEN 2 WHEN 'UNKNOWN' THEN 3 WHEN 'FAILED' THEN 4 ELSE 3 END) OVER (PARTITION BY job_name, environment)) AS job_worst_status,\n",
        "  MAX(CASE status WHEN 'HEALTHY' THEN 1 WHEN 'WARNING' THEN 2 WHEN 'UNKNOWN' THEN 3 WHEN 'FAILED' THEN 4 ELSE 3 END) OVER (PARTITION BY job_name, environment) AS job_worst_rank\n",
        "FROM {{catalog}}.{{schema}}.findings_latest\n"
      ]
    },
    {
      "name": "ds_problems",
      "displayName": "Problems (not HEALTHY)",
      "queryLines": [
        "SELECT\n",
        "  observed_at, environment, workspace_name, job_name, check_id, status, severity, error_summary,\n",
        "  array_join(affected_jobs, ', ') AS affected_jobs_text, code_version, run_page_url,\n",
        "  CASE status WHEN 'FAILED' THEN 1 WHEN 'UNKNOWN' THEN 2 WHEN 'WARNING' THEN 3 ELSE 4 END AS status_order,\n",
        "  CASE WHEN severity = 'CRITICAL' THEN 1 ELSE 2 END AS severity_order\n",
        "FROM {{catalog}}.{{schema}}.findings_latest\n",
        "WHERE status <> 'HEALTHY'\n",
        "ORDER BY status_order, severity_order, environment, job_name, check_id\n"
      ]
    },
    {
      "name": "ds_runs",
      "displayName": "Latest run per job and workspace",
      "queryLines": [
        "SELECT\n",
        "  job_name, workspace_name, environment, code_version, pipeline_url, trigger_type, triggered_by,\n",
        "  run_start_time, run_end_time,\n",
        "  ROUND(CASE\n",
        "          WHEN run_start_time IS NOT NULL AND run_end_time IS NOT NULL\n",
        "            THEN (unix_timestamp(run_end_time) - unix_timestamp(run_start_time)) / 60.0\n",
        "          ELSE run_duration_seconds / 60.0\n",
        "        END, 1) AS duration_minutes,\n",
        "  status\n",
        "FROM {{catalog}}.{{schema}}.findings_latest\n",
        "WHERE check_id IN ('live_run_status', 'last_run_result')\n",
        "QUALIFY ROW_NUMBER() OVER (\n",
        "  PARTITION BY job_name, workspace_id, job_id\n",
        "  ORDER BY CASE WHEN check_id = 'live_run_status' THEN 1 ELSE 2 END) = 1\n",
        "ORDER BY job_name, workspace_name\n"
      ]
    },
    {
      "name": "ds_scans",
      "displayName": "Status per scan (30 days)",
      "queryLines": [
        "SELECT s.scan_time, f.status, COUNT(*) AS findings\n",
        "FROM {{catalog}}.{{schema}}.findings AS f\n",
        "JOIN (\n",
        "  SELECT scan_id, MIN(observed_at) AS scan_time\n",
        "  FROM {{catalog}}.{{schema}}.findings\n",
        "  WHERE observed_at >= date_sub(current_date(), 30)\n",
        "  GROUP BY scan_id\n",
        ") AS s\n",
        "  ON f.scan_id = s.scan_id\n",
        "WHERE f.observed_at >= date_sub(current_date(), 30)\n",
        "GROUP BY s.scan_time, f.status\n",
        "ORDER BY s.scan_time, f.status\n"
      ]
    },
    {
      "name": "ds_failed",
      "displayName": "FAILED rows by job (7 days)",
      "queryLines": [
        "SELECT job_name, environment, COUNT(*) AS failed_findings\n",
        "FROM {{catalog}}.{{schema}}.findings\n",
        "WHERE status = 'FAILED' AND observed_at >= date_sub(current_date(), 7)\n",
        "GROUP BY job_name, environment\n",
        "ORDER BY failed_findings DESC, job_name\n",
        "LIMIT 25\n"
      ]
    }
  ],
