                "x": {
                  "fieldName": "scan_time",
                  "displayName": "Scan",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "sum(findings)",
                  "displayName": "Rows",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "status",
                  "displayName": "Status",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
